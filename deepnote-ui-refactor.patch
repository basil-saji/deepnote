+        if (available <= 0) return;
+        int columns = listMode() ? 1 : available >= 1020 ? 3 : available >= 660 ? 2 : 1;
+        double width = Math.floor((available - GAP * (columns - 1)) / columns);
+        for (FlowPane grid : grids) {
